# ==============================================================================
# VoiceGroceries - Kroger Developer API Credentials
# ==============================================================================
# 1. Register a developer account at https://developer.kroger.com
# 2. Create a new App in the developer portal.
# 3. Add the following scopes:
#    - cart.basic:write
#    - product.compact
#    - profile.compact
# 4. Set the OAuth Redirect URI to:
#    http://localhost:3000/api/auth/kroger/callback
# 5. Copy your Client ID and Client Secret below, and rename this file to '.env.local':

KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_REDIRECT_URI=http://localhost:3000/api/auth/kroger/callback
KROGER_DEFAULT_LOCATION_ID=

# ==============================================================================
# Neon Postgres Database (Optional locally - falls back to data/usuals.json)
# Required for persistent storage on Vercel
# ==============================================================================
# Pooled connection string from console.neon.tech (with -pooler)
DATABASE_URL=
# Direct connection string from console.neon.tech (without -pooler, for migrations)
DIRECT_URL=
